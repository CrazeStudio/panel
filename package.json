{
  "name": "crazepanel",
  "version": "2.0.0",
  "private": true,
  "description": "Self-hosted game server management panel and node agent",
  "workspaces": ["panel", "agent"],
  "engines": { "node": ">=22 <25" },
  "scripts": {
    "start": "npm run start --workspace @crazepanel/panel",
    "start:agent": "npm run start --workspace @crazepanel/agent",
    "dev": "npm run dev --workspace @crazepanel/panel",
    "test": "node --test tests/*.test.js"
  }
}
