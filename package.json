{
  "name": "crazepanel",
  "version": "2.0.0",
  "private": true,
  "description": "Self-hosted game server management panel and node agent",
  "workspaces": ["panel", "agent"],
  "engines": { "node": ">=22 <25" },
  "scripts": {
    "start": "node panel/src/index.js",
    "start:agent": "node agent/src/index.js",
    "dev": "node --watch panel/src/index.js",
    "dev:agent": "node --watch agent/src/index.js",
    "test": "node --test tests/*.test.js",
    "check": "node --check panel/src/index.js && node --check agent/src/index.js"
  }
}
